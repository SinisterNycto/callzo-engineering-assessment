# Copy to .env to override the local-dev defaults baked into docker-compose.yml.
# Never commit a real .env.
POSTGRES_PASSWORD=callzo_local_dev
WEBHOOK_SECRET=callzo_test_secret_change_me
# Comma-separated; more than one lets you rotate keys without downtime.
API_KEYS=local_dev_api_key
DEFAULT_MONTHLY_CAP_CENTS=500
SIMULATOR_SCENARIO=all
